---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { company } from '../data/company';
import { web3formsKey } from '../data/forms';
const accessKey = web3formsKey;
const configured = !!accessKey;
const phoneHref = company.phone.replace(/[^+\d]/g, '');
---
<Layout title="Connect With Us">
  <section class="page-hero image-page-hero contact-hero">
    <img class="hero-image page-hero-image" src="/images/contact-hero.jpg" width="2400" height="1602" alt="Construction professionals reviewing plans together" fetchpriority="high" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap"><p class="eyebrow">CONNECT WITH SRINIDHI</p><h1>Let’s build<br />a conversation.</h1><p>Have a project in mind? Tell us a little about it.</p></div>
    <div class="page-hero-foot wrap"><a href="#contact-details">CONNECT WITH US <span aria-hidden="true">↓</span></a></div>
  </section>
  <section class="section wrap contact-layout" id="contact-details"><div class="contact-info"><p class="eyebrow red">GET IN TOUCH</p><h2>Your next project<br />starts here.</h2><p>Share your requirements, project location, and the best way to reach you.</p><div class="contact-details"><div class="contact-detail"><span>Your contact</span>{company.name}</div>{company.email && <div class="contact-detail"><span>Email us</span><div class="contact-email-links"><a href={`mailto:${company.email}`}>{company.email}</a><a href={`mailto:${company.alternateEmail}`}>{company.alternateEmail}</a></div></div>}{company.phone && <div class="contact-detail"><span>Call us</span><a href={`tel:${phoneHref}`}>{company.phone}</a></div>}{company.address && <div class="contact-detail"><span>Visit us</span>{company.address}</div>}<div class="contact-detail"><span>Corresponding offices</span>Bangalore · Goa</div></div></div>
  <form class="enquiry-form" id="enquiry-form" action="https://api.web3forms.com/submit" method="POST" data-configured={String(configured)}>
    <h2>Send an enquiry</h2><p class="form-intro">Fields marked * are required.</p>
    {!configured && <p class="form-unavailable"><strong>Direct delivery is being activated.</strong> The form will send inside this page once the company email is connected. You can still connect with us at <a href={`mailto:${company.email}`}>{company.email}</a>.</p>}
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="New website enquiry — SriNidhi Engineers" />
    <input type="hidden" name="from_name" value="SriNidhi Engineers website" />
    <input class="honeypot" type="checkbox" name="botcheck" tabindex="-1" aria-hidden="true" autocomplete="off" />
    <div class="form-row"><div class="field"><label for="name">Full name *</label><input id="name" name="name" autocomplete="name" placeholder="Your name" required maxlength="120" /></div><div class="field"><label for="phone">Phone number <span>(optional)</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="Your phone number" maxlength="40" /></div></div>
    <div class="field"><label for="email">Email address *</label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required maxlength="254" /></div>
    <div class="field"><label for="message">Tell us about your project *</label><textarea id="message" name="message" rows="5" placeholder="Project type, location, scope, or anything else you’d like us to know…" required minlength="10" maxlength="5000"></textarea></div>
    <p class="form-privacy">We’ll use your details to respond to your enquiry. Read our <a href="/privacy/">privacy notice</a>.</p>
    <button class="button" type="submit" disabled={!configured}><span>{configured ? 'Send enquiry' : 'Enquiry form activating'}</span><Arrow diagonal /></button>
    <p class="form-status" id="form-status" role="status" aria-live="polite" tabindex="-1"></p>
    <noscript><p>Enable JavaScript to submit an enquiry through this page.</p></noscript>
  </form></section>
  <script>
    import '../scripts/enquiry';
  </script>
</Layout>
