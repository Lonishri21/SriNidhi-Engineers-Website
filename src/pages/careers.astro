---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { company } from '../data/company';
import { openings } from '../data/careers';
import { web3formsKey } from '../data/forms';
---
<Layout title="Careers" description="Current job openings at SriNidhi Engineers.">
  <section class="page-hero">
    <div class="wrap"><p class="eyebrow">CAREERS</p><h1>Build your career<br />with SriNidhi.</h1></div>
  </section>

  <section class="section wrap content-split" id="openings">
    <div><p class="eyebrow red">CURRENT OPENINGS</p><h2>Roles open<br />right now.</h2></div>
    <div>
      {openings.length ? <div class="job-list">
        {openings.map(job => <article class="job-card">
          <h3>{job.title}</h3>
          <dl class="job-meta">
            <div><dt>Experience</dt><dd>{job.experience}</dd></div>
            <div><dt>Qualification</dt><dd>{job.qualification}</dd></div>
            <div><dt>Work type</dt><dd>{job.workType}</dd></div>
          </dl>
          <button class="button" type="button" data-apply-role={job.title}>Apply for this role <Arrow diagonal /></button>
        </article>)}
      </div> : <div class="prose"><p>There are no openings at the moment.</p></div>}
      <p class="careers-note">You can also email your CV to <a href={`mailto:${company.email}`}>{company.email}</a>.</p>
    </div>
  </section>

  <dialog class="apply-dialog" id="apply-dialog" aria-labelledby="apply-title">
    <button class="apply-close" type="button" aria-label="Close application form">Close <span aria-hidden="true">×</span></button>
    <form class="enquiry-form apply-form" id="apply-form" action="https://api.web3forms.com/submit" method="POST">
      <p class="eyebrow red">JOB APPLICATION</p>
      <h2 id="apply-title">Apply for this role</h2>
      <p class="form-intro"><strong id="apply-role-name"></strong><br />Fields marked * are required.</p>
      <input type="hidden" name="access_key" value={web3formsKey} />
      <input type="hidden" name="subject" value="New job application — SriNidhi Engineers" />
      <input type="hidden" name="from_name" value="SriNidhi Engineers careers page" />
      <input type="hidden" name="role" value="" />
      <input class="honeypot" type="checkbox" name="botcheck" tabindex="-1" aria-hidden="true" autocomplete="off" />
      <div class="field"><label for="apply-name">Full name *</label><input id="apply-name" name="name" autocomplete="name" placeholder="Your name" required maxlength="120" /></div>
      <div class="form-row">
        <div class="field"><label for="apply-age">Age *</label><input id="apply-age" name="age" type="number" inputmode="numeric" min="18" max="70" placeholder="e.g. 28" required /></div>
        <div class="field"><label for="apply-experience">Work experience (years) *</label><input id="apply-experience" name="work_experience_years" type="number" inputmode="decimal" min="0" max="50" step="0.5" placeholder="e.g. 3" required /></div>
      </div>
      <div class="field"><label for="apply-qualification">Degree / qualification *</label><input id="apply-qualification" name="qualification" placeholder="e.g. B.E. Civil, Diploma in Mechanical" required maxlength="200" /></div>
      <div class="form-row">
        <div class="field"><label for="apply-phone">Phone number *</label><input id="apply-phone" name="phone" type="tel" autocomplete="tel" placeholder="Your phone number" required maxlength="40" /></div>
        <div class="field"><label for="apply-email">Email address <span>(optional)</span></label><input id="apply-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" maxlength="254" /></div>
      </div>
      <p class="form-privacy">We’ll use your details only to consider your application. Read our <a href="/privacy/">privacy notice</a>.</p>
      <button class="button" type="submit"><span>Submit application</span><Arrow diagonal /></button>
      <p class="form-status" id="apply-status" role="status" aria-live="polite" tabindex="-1"></p>
    </form>
  </dialog>

  <script>
    import '../scripts/apply';
  </script>
</Layout>
